<Window x:Class="LinuxCmdHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinuxCmdHelper"
        mc:Ignorable="d"
        Title="极速命令助手 (Linux / SQL / Docker / K8s / Git / Nginx)" Height="720" Width="1160"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="#EEEEEE" Foreground="#18181B"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, Arial">

    <Window.Resources>
        <!-- #EEEEEE 浅色现代化配色体系 -->
        <SolidColorBrush x:Key="BgWindow" Color="#EEEEEE" />
        <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgSidebar" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BgList" Color="#F3F4F6" />
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgCardHover" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BgCardActive" Color="#E0F2FE" />
        <SolidColorBrush x:Key="BgCode" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderLight" Color="#D1D5DB" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextMain" Color="#111827" />
        <SolidColorBrush x:Key="TextSub" Color="#4B5563" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentColor" Color="#0284C7" />
        <SolidColorBrush x:Key="AccentHover" Color="#0369A1" />
        <SolidColorBrush x:Key="CodeText" Color="#0369A1" />
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981" />
        <SolidColorBrush x:Key="DangerBg" Color="#FEE2E2" />
        <SolidColorBrush x:Key="DangerBorder" Color="#F87171" />
        <SolidColorBrush x:Key="DangerText" Color="#DC2626" />
        <SolidColorBrush x:Key="WarningBg" Color="#FEF3C7" />
        <SolidColorBrush x:Key="WarningBorder" Color="#FBBF24" />
        <SolidColorBrush x:Key="WarningText" Color="#D97706" />

        <!-- 扁平主按钮 -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮 -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索输入框 -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6,50,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#0284C7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden" 
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统一输入框样式 -->
        <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#0284C7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden" 
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox 扁平无边框样式 -->
        <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#EEEEEE">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 顶部导航 -->
            <RowDefinition Height="*"/>
            <!-- 核心三栏主体 -->
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌标志 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#0284C7" Margin="0,0,12,0">
                        <TextBlock Text="CMD" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="极速命令助手" FontWeight="Bold" FontSize="16" Foreground="#111827" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 顶部中央搜索框 -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="460">
                    <TextBox x:Name="TxtSearch" Style="{StaticResource SearchTextBoxStyle}" Height="40" TextChanged="TxtSearch_TextChanged" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="搜索需求 (如: 归档压缩, 慢查询, k8s pod, 端口占用, 索引优化...)" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Right" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+F" FontSize="10" Foreground="#6B7280"/>
                    </Border>
                </Grid>

                <!-- 右侧辅助按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportHtml" Content="📤 导出 Web 版" Style="{StaticResource SecondaryBtnStyle}" Click="BtnExportHtml_Click" Margin="0,0,8,0" ToolTip="将当前全量命令库导出为独立单文件 HTML (支持跨平台 Linux/Mac 任意浏览器使用)"/>
                    <Button x:Name="BtnQuickSync" Content="🔄 刷新/同步" Style="{StaticResource SecondaryBtnStyle}" Click="BtnQuickSync_Click" Margin="0,0,8,0" ToolTip="同步所有启用的远程数据源"/>
                    <Button x:Name="BtnDataSources" Content="📡 数据源配置" Style="{StaticResource SecondaryBtnStyle}" Click="BtnDataSources_Click" Margin="0,0,8,0" ToolTip="配置外部/远程 JSON 接口数据源"/>
                    <Button x:Name="BtnReset" Content="重置参数" Style="{StaticResource SecondaryBtnStyle}" Click="BtnReset_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 核心三栏主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/>
                <!-- 1. 左侧分类 -->
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500"/>
                <!-- 2. 中间需求列表 -->
                <ColumnDefinition Width="*"/>
                <!-- 3. 右侧参数与命令拼装 -->
            </Grid.ColumnDefinitions>

            <!-- 1. 左侧分类侧边栏 -->
            <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="场景分类" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="16,16,16,8"/>

                    <ListBox x:Name="LstCategories" Grid.Row="1" Style="{StaticResource CleanListBoxStyle}" SelectionChanged="LstCategories_SelectionChanged" Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CatBorder" CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#E5E7EB" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CatBorder" Property="Background" Value="#E0F2FE"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 2. 中间需求列表 -->
            <Border Grid.Column="1" Background="#EEEEEE" BorderBrush="#D1D5DB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EEEEEE" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid>
                            <TextBlock x:Name="TxtCategoryTitle" Text="全部需求场景" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock x:Name="TxtCategoryCount" Text="共 0 条" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LstCommands" Grid.Row="1" Style="{StaticResource CleanListBoxStyle}" SelectionChanged="LstCommands_SelectionChanged" Padding="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap"/>
                                            <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasDangerBadge, Converter={x:Static local:Converters.BoolToVisConverter}}">
                                                <TextBlock Text="{Binding DangerBadgeText}" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" MaxHeight="32" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                            <TextBlock Text="{Binding Example}" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0284C7"/>
                                        <Setter TargetName="CardBorder" Property="Background" Value="#E0F2FE"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 3. 右侧参数与命令拼装面板 -->
            <ScrollViewer Grid.Column="2" Background="#EEEEEE" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20">

                    <!-- 需求头部信息 -->
                    <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtDetailCategory" Text="Linux 运维" FontSize="11" Foreground="#0369A1" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="BorderDangerWarning" Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="8,3" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtDangerWarning" Text="危险操作" FontSize="11" Foreground="#DC2626" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtDetailTitle" Text="归档并压缩指定文件或目录" FontSize="18" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDetailDesc" Text="使用 tar 打包并选用 gzip/bzip2/xz 压缩算法生成压缩归档文件" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- 实时拼接命令展示区与复制按钮 -->
                    <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="实时拼接命令 (点击一键复制)" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Button x:Name="BtnCopyCommand" Content="📋 复制完整命令" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right" Click="BtnCopyCommand_Click"/>
                            </Grid>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBox x:Name="TxtFinalCommand" Background="Transparent" Foreground="#0369A1" FontSize="14" FontFamily="Cascadia Code, Consolas, Courier New" FontWeight="SemiBold" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="280" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="TxtFinalCommand_PreviewMouseDown" ToolTip="点击即可复制到剪贴板"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 参数动态配置面板 -->
                    <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="4" Height="14" Background="#0284C7" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="参数动态设置 (修改后实时更新上方命令)" FontSize="13" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 动态参数控件容器 -->
                            <StackPanel x:Name="PnlParamControls">
                                <!-- 由 C# 动态生成 -->
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 标准示例与场景解析 -->
                    <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="4" Height="14" Background="#6B7280" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="标准示例 / 场景说明" FontSize="13" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="TxtExampleBox" Text="tar -czvf app-service.log.tar.gz app-service.log" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="#334155" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 浮动复制成功提示 Toast -->
        <Border x:Name="ToastBorder" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#059669" CornerRadius="8" Padding="16,10" Margin="0,0,30,30" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✔ " FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                <TextBlock Text="已成功复制命令到剪贴板！" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
