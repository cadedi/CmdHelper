[
  {
    "id": "tar_compress",
    "category": "Linux 运维",
    "title": "归档并压缩指定文件或目录",
    "desc": "使用 tar 打包并选用 gzip/bzip2/xz 压缩算法生成压缩归档文件",
    "template": "tar -c{compress_opt}vf {archive_name} {target_path}",
    "params": [
      {
        "key": "compress_opt",
        "label": "压缩算法",
        "type": "select",
        "default": "z",
        "options": [
          { "label": "gzip (速度快, 后缀 .tar.gz)", "value": "z" },
          { "label": "bzip2 (压缩率高, 后缀 .tar.bz2)", "value": "j" },
          { "label": "xz (极致压缩率, 后缀 .tar.xz)", "value": "J" }
        ]
      },
      {
        "key": "archive_name",
        "label": "输出归档文件名",
        "type": "text",
        "default": "app-service.log.tar.gz",
        "placeholder": "app-service.log.tar.gz"
      },
      {
        "key": "target_path",
        "label": "待压缩的文件或目录",
        "type": "text",
        "default": "app-service.log",
        "placeholder": "app-service.log"
      }
    ],
    "example": "tar -czvf app-service.log.tar.gz app-service.log",
    "dangerLevel": "normal",
    "tags": ["linux", "tar", "compress", "zip", "gzip", "打包", "压缩", "归档"]
  },
