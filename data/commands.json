    "category": "Windows & PowerShell",
    "title": "PowerShell 查找占用指定端口的进程并强制释放",
    "desc": "通过 Get-NetTCPConnection 查找监听端口的 OwningProcess 并调用 Stop-Process",
    "template": "Get-NetTCPConnection -LocalPort {port} -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess | ForEach-Object { Stop-Process -Id $_ -Force }",
    "params": [
      {
        "key": "port",
        "label": "端口号",
        "type": "text",
        "default": "8080",
        "placeholder": "8080"
      }
