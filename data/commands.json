  {
    "id": "pg_slow_query_stat",
    "category": "SQL 数据库",
    "title": "PostgreSQL 排查正在运行的慢查询与耗时",
    "desc": "查询 pg_stat_activity 视图中当前执行超过指定时长的活跃查询语句",
    "template": "SELECT pid, now() - query_start AS duration, query, state FROM pg_stat_activity WHERE state != 'idle' AND (now() - query_start) > interval '{seconds} seconds' ORDER BY duration DESC;",
    "params": [
      {
        "key": "seconds",
        "label": "耗时阈值 (秒)",
        "type": "text",
        "default": "5",
        "placeholder": "5"
      }
    ],
    "example": "SELECT pid, now() - query_start AS duration, query, state FROM pg_stat_activity WHERE state != 'idle' AND (now() - query_start) > interval '5 seconds' ORDER BY duration DESC;",
    "dangerLevel": "normal",
    "tags": ["sql", "postgresql", "慢查询", "pg_stat_activity", "性能排查"]
  },
  {
    "id": "pg_lock_blocking_chain",
    "category": "SQL 数据库",
    "title": "PostgreSQL 锁等待与阻塞链分析",
    "desc": "查询当前产生锁冲突的阻塞会话 (Blocking PID) 与被阻塞会话 (Blocked PID)",
    "template": "SELECT blocking.pid AS blocking_pid, blocking.query AS blocking_query, blocked.pid AS blocked_pid, blocked.query AS blocked_query FROM pg_stat_activity blocked JOIN pg_stat_activity blocking ON blocking.pid = ANY(pg_blocking_pids(blocked.pid)) WHERE cardinality(pg_blocking_pids(blocked.pid)) > 0;",
    "params": [],
    "example": "SELECT blocking.pid AS blocking_pid, blocking.query AS blocking_query, blocked.pid AS blocked_pid, blocked.query AS blocked_query FROM pg_stat_activity blocked JOIN pg_stat_activity blocking ON blocking.pid = ANY(pg_blocking_pids(blocked.pid)) WHERE cardinality(pg_blocking_pids(blocked.pid)) > 0;",
    "dangerLevel": "normal",
    "tags": ["sql", "postgresql", "锁冲突", "死锁", "阻塞排查"]
