    "tags": ["linux", "zgrep", "log", "统计", "压缩日志", "排障"]
  },
  {
    "id": "find_and_move",
    "category": "Linux 运维",
    "title": "按文件名模式查找并批量移动到指定目录",
    "desc": "递归或单层查找匹配特定名称模式的文件并执行批量 mv 归档",
    "template": "mkdir -p {dest_dir} && find {search_dir} -maxdepth {max_depth} -name '{file_pattern}' -type f -exec mv {{}} {dest_dir}/ \\;",
    "params": [
      {
        "key": "search_dir",
        "label": "搜索起始目录",
        "type": "text",
        "default": ".",
        "placeholder": "."
      },
      {
        "key": "max_depth",
        "label": "最大搜索深度",
        "type": "text",
        "default": "1",
        "placeholder": "1"
      },
      {
        "key": "file_pattern",
        "label": "文件名匹配通配符",
        "type": "text",
        "default": "*2026-01*",
        "placeholder": "*2026-01*"
      },
      {
        "key": "dest_dir",
        "label": "目标归档目录",
        "type": "text",
        "default": "archived_logs",
        "placeholder": "archived_logs"
      }
    ],
    "example": "mkdir -p archived_logs && find . -maxdepth 1 -name '*2026-01*' -type f -exec mv {} archived_logs/ \\;",
    "dangerLevel": "normal",
    "tags": ["linux", "find", "mv", "批量移动", "归档", "文件管理"]
  },
